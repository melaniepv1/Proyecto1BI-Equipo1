    <connection>proyecto_bi</connection>
    <sql>SELECT
    dv.id_venta_detalle,
    v.id_venta,
    v.fecha::date AS fecha_venta,

    dv.id_producto,
    v.id_sucursal,
    v.id_cliente,
    v.id_canal,
    v.id_metodo_pago,
    dv.id_promocion,

    dv.cantidad AS cantidad_vendida,
    dv.precio_unitario,
    dv.descuento AS monto_descuento,

    p.costo_unitario

FROM supermercado.detalle_venta dv
INNER JOIN supermercado.venta v
    ON dv.id_venta = v.id_venta
INNER JOIN supermercado.producto p
    ON dv.id_producto = p.id_producto;</sql>
    <limit>0</limit>
    <lookup/>
