      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>proyecto_bi</connection>
    <sql>SELECT
    i.fecha AS fecha_corte,
    i.id_producto,
    i.id_sucursal,
    i.stock_actual,
    i.stock_minimo,

    COALESCE(
        SUM(dv.cantidad),
        0
    )::INTEGER AS unidades_vendidas_semana,

    CASE
        WHEN i.stock_actual = 0 THEN 1
        ELSE 0
    END::SMALLINT AS flag_quiebre,

    CASE
        WHEN i.stock_actual > 0
         AND i.stock_actual &lt; i.stock_minimo THEN 1
        ELSE 0
    END::SMALLINT AS flag_bajo_inventario

FROM supermercado.inventario i

LEFT JOIN supermercado.venta v
    ON v.id_sucursal = i.id_sucursal
    AND v.fecha::date BETWEEN i.fecha - INTERVAL '6 days' AND i.fecha

LEFT JOIN supermercado.detalle_venta dv
    ON dv.id_venta = v.id_venta
    AND dv.id_producto = i.id_producto

GROUP BY
    i.fecha,
    i.id_producto,
    i.id_sucursal,
    i.stock_actual,
    i.stock_minimo;</sql>
    <limit>0</limit>
    <lookup/>
